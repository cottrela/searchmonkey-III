{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://searchmonkey.dev/schemas/sm-plugin-job.v1.schema.json",
  "title": "Searchmonkey Plugin Job v1",
  "type": "object",
  "required": [
    "schema",
    "job_id",
    "plugin_id",
    "source_path",
    "output_text_path",
    "output_meta_path"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "sm.plugin-job.v1"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "plugin_id": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "source_path": {
      "type": "string",
      "minLength": 1
    },
    "output_text_path": {
      "type": "string",
      "minLength": 1
    },
    "output_meta_path": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "mtime": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "settings": {
      "type": "object",
      "properties": {
        "layout": {
          "type": "boolean",
          "default": true
        },
        "ocr": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}